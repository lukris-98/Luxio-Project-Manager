# Database - Neon PostgreSQL
DATABASE_URL=postgres://username:password@host.neon.tech/luxio?sslmode=require

# Neon API Configuration
# ------------------------
# NEON_API_KEY: Organization API Key (untuk akses organization-level data)
#   - Buat di Neon Console → Organization Settings → API Keys
#   - Organization API Key bisa akses: storage consumption, billing, members, semua projects
#   - Personal API Key HANYA bisa akses: individual projects, branches, databases
#   - Untuk fitur Storage Tab di halaman Penyimpanan, WAJIB pakai Organization API Key
#
# NEON_ORG_ID: Organization ID kamu di Neon
#   - Format: org-xxxxx-xxxxx-xxxxx (contoh: org-curly-bonus-71722205)
#   - Bisa dilihat di URL console.neon.tech saat membuka organization
#
NEON_API_KEY=
NEON_ORG_ID=

# Server
PORT=3000

# CORS - daftar origin yang boleh memanggil API (dipisah koma)
# Default dev: localhost:5173. Untuk produksi set ke domain frontend, contoh:
# ALLOWED_ORIGIN=https://diarsipin.web.id,https://www.diarsipin.web.id
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# URL depan aplikasi — dipakai untuk link konfirmasi email (?token=).
# Harus URL frontend yang bisa dibuka user.
APP_URL=http://localhost:5173

# Akun OWNER (pemilik website) - WAJIB diatur untuk produksi.
# JANGAN pakai password contoh ini di production!
OWNER_EMAIL=master@diarsipin.web.id
OWNER_PASSWORD=ganti-dengan-password-kuat-20+karakter
OWNER_NAME=Master Owner

# SMTP untuk kirim email (welcome anggota, notifikasi ke email).
# Untuk Gmail: SMTP_HOST=smtp.gmail.com, port 587,
# SMTP_USERNAME=email gmail kamu, SMTP_PASSWORD=App Password (16 karakter,
# buat di https://myaccount.google.com/apppasswords). JANGAN pakai password
# gmail biasa.
# Kosongkan SMTP_HOST untuk menonaktifkan email (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Mode pengiriman email alternatif (HTTP API, aman di platform yang memblokir
# port SMTP seperti Hugging Face Spaces).
#   MAIL_PROVIDER=resend
#   RESEND_API_KEY=re_xxxx (dari https://resend.com)
#   SMTP_FROM=Nama <alamat@domain-terverifikasi>
# Jika MAIL_PROVIDER=resend dan RESEND_API_KEY terisi, SMTP diabaikan.
