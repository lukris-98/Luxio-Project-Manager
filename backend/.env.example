# Database - Neon PostgreSQL
DATABASE_URL=postgres://username:password@host.neon.tech/luxio?sslmode=require

# Server
PORT=3000

# CORS - daftar origin yang boleh memanggil API (dipisah koma)
# Default dev: localhost:5173. Untuk produksi set ke domain frontend, contoh:
# ALLOWED_ORIGIN=https://luxio.web.id,https://www.luxio.web.id
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Akun OWNER (pemilik website) - WAJIB diatur untuk produksi.
# JANGAN pakai password contoh ini di production!
OWNER_EMAIL=master@luxio.web.id
OWNER_PASSWORD=ganti-dengan-password-kuat-20+karakter
OWNER_NAME=Master Owner
